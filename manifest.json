{
  "manifest_version": 3,
  "name": "先听十分钟",
  "version": "1.4.2",
  "description": "打开浏览器，先完成十分钟英语听力；按天轮换本地视频。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "先听十分钟"
  },
  "options_page": "index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
